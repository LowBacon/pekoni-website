# --- Pekoni environment -------------------------------------------------
# SQLite is the zero-config default so the project runs anywhere.
# To move to PostgreSQL: set provider = "postgresql" in prisma/schema.prisma
# and point DATABASE_URL at your instance, then run `npm run db:migrate`.
DATABASE_URL="file:./dev.db"

# 32+ random characters. Used to sign session cookies and derive game seeds.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PEKONI_SECRET="dev-only-secret-change-me-0000000000000000000000000000000000000000"

# Minecraft server addresses surfaced in the Server Status card.
PEKONI_JAVA_HOST="Finlandsmp.usga.me"
PEKONI_BEDROCK_HOST="Finlandsmp.usga.me"
PEKONI_BEDROCK_PORT="12009"

# Username promoted to OWNER when it registers (optional).
#
# Only fires at registration with a password, and only for an exact match, so it
# cannot help an account that already exists or one created through Google or
# Discord. For those, use:
#   npx tsx --env-file-if-exists=.env scripts/grant-role.ts <username> OWNER
PEKONI_OWNER_USERNAME=""

# --- Sign in with Google / Discord --------------------------------------
# Both are optional and independent: a provider whose id and secret are both
# present gets a button, the others simply do not appear.
#
# The redirect URI must be registered with the provider *exactly* as written:
#   Google  → https://console.cloud.google.com/apis/credentials
#             The client must be of type "Web application"; other types have no
#             redirect URI list at all and every attempt fails as a mismatch.
#             "Authorised redirect URI": <origin>/api/auth/callback/google
#   Discord → https://discord.com/developers/applications  →  OAuth2
#             "Redirect": <origin>/api/auth/callback/discord
#
# The older <origin>/api/auth/oauth/<provider>/callback form is still served, so
# a console configured that way keeps working; new setups should use the above.
# For local development the origin is http://localhost:3000.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# The public origin, without a trailing slash. Required behind a proxy or a
# tunnel, where the request headers do not describe the URL the browser used.
# Leave empty in local development.
PEKONI_PUBLIC_URL=""

# --- Minecraft server integration ---------------------------------------
# Shared secret between this site and the Pekoni plugin on your Minecraft
# server. Without it, account linking and coin transfers stay switched off and
# say so in the UI — they are never faked.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Put the SAME value in the plugin config. Minimum 32 characters.
PEKONI_PLUGIN_SECRET=""

# --- Static / GitHub Pages build ----------------------------------------
# Set by scripts/build-static.mjs; only needed if you build by hand.
# NEXT_PUBLIC_PEKONI_STATIC="1"
# Base path for a GitHub Pages project site, e.g. "/Pekoni-s-Website".
# NEXT_PUBLIC_BASE_PATH=""
# Server addresses for the static build (baked in at build time).
# NEXT_PUBLIC_PEKONI_JAVA_HOST="Finlandsmp.usga.me"
# NEXT_PUBLIC_PEKONI_BEDROCK_HOST="Finlandsmp.usga.me"
# NEXT_PUBLIC_PEKONI_BEDROCK_PORT="12009"
